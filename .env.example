# Google Places — address autocomplete and /enquiry reverse geocoding
# Enquiry map uses classic Google Maps iframe (Map/Satellite/Labels controls)
# Nominatim/OpenStreetMap is used for reverse geocoding when this key is not set
GOOGLE_PLACES_API_KEY=

# SMTP — required for /enquiry PDF email notifications
# Hostinger example: smtp.hostinger.com (port 587 + SMTP_SECURE=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
ENQUIRY_EMAIL_FROM=
ENQUIRY_EMAIL_TO=help@utilitychoice.com.au

# Optional — where enquiry JSON records are saved locally
ENQUIRY_STORAGE_DIR=data/enquiries

# ZFour CMS backend (z4server) — tracking, leads, and blog
Z4SERVER_API_URL=http://localhost:3001
Z4SERVER_PROJECT=utility_choice
NEXT_PUBLIC_Z4SERVER_API_URL=http://localhost:3001
NEXT_PUBLIC_Z4SERVER_PROJECT=utility_choice

# Blog CMS API — proxied via /api/blogs
BLOG_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_BLOG_API_BASE_URL=http://localhost:3001
