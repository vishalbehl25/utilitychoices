{
  "name": "utility-choice-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-dev-cache.mjs",
    "dev": "next dev",
    "dev:clean": "lsof -ti:3000,3001,3002 2>/dev/null | xargs kill -9 2>/dev/null; rm -rf .next node_modules/.cache && npm run dev",
    "postbuild": "node -e \"console.log('\\nNote: Run npm run dev:clean (not npm run dev) after npm run build to avoid vendor-chunks errors.\\n')\"",
    "download-assets": "node scripts/download-assets.mjs",
    "download-all-assets": "node scripts/download-all-assets.mjs",
    "check-remote-assets": "node scripts/check-remote-assets.mjs",
    "verify-assets": "node scripts/verify-local-assets.mjs && node scripts/check-remote-assets.mjs",
    "download-credit-card-images": "node scripts/download-credit-card-images.mjs",
    "scrape-credit-card-tables": "node scripts/scrape-credit-card-detail-tables.mjs",
    "refresh-credit-card-prose": "node scripts/refresh-credit-card-prose.mjs",
    "refresh-credit-card-data": "node scripts/refresh-credit-card-prose.mjs && node scripts/build-credit-card-details.mjs",
    "prebuild": "npm run verify-assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "progress": "node scripts/generate-progress.mjs",
    "refresh-home-loan-data": "node scripts/apply-official-home-loan-data.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "geoip-lite": "^2.0.2",
    "lucide-react": "^1.17.0",
    "next": "15.5.18",
    "nodemailer": "^8.0.10",
    "pdfkit": "^0.19.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.77.0",
    "react-redux": "^9.3.0",
    "sharp": "^0.34.5",
    "swiper": "^12.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
